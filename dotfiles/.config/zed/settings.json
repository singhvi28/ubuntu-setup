// Zed settings - Optimized for low memory footprint
{
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "cli_default_open_behavior": "new_window",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Ayu Dark"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/node_modules",
    "**/dist",
    "**/build",
    "**/.next",
    "**/.nuxt",
    "**/.cache",
    "**/.venv",
    "**/venv",
    "**/env",
    "**/target",
    "**/out",
    "**/.turbo"
  ],
  "lsp": {
    "vtsls": {
      "initialization_options": {
        "typescript": {
          "tsserver": {
            "maxTsServerMemory": 1024
          }
        }
      }
    }
  }
}
