[app-folders]
folder-children=['Utilities', 'YaST', 'Pardus']

[app-folders/folders/Pardus]
categories=['X-Pardus-Apps']
name='X-Pardus-Apps.directory'
translate=true

[app-folders/folders/Utilities]
apps=['gnome-abrt.desktop', 'gnome-system-log.desktop', 'nm-connection-editor.desktop', 'org.gnome.baobab.desktop', 'org.gnome.Connections.desktop', 'org.gnome.DejaDup.desktop', 'org.gnome.Dictionary.desktop', 'org.gnome.DiskUtility.desktop', 'org.gnome.Evince.desktop', 'org.gnome.FileRoller.desktop', 'org.gnome.fonts.desktop', 'org.gnome.Loupe.desktop', 'org.gnome.seahorse.Application.desktop', 'org.gnome.tweaks.desktop', 'org.gnome.Usage.desktop', 'vinagre.desktop']
categories=['X-GNOME-Utilities']
name='X-GNOME-Utilities.directory'
translate=true

[app-folders/folders/YaST]
categories=['X-SuSE-YaST']
name='suse-yast.directory'
translate=true

[background]
color-shading-type='solid'
picture-options='zoom'
picture-uri='file:///usr/share/backgrounds/ubuntu-wallpaper-d.png'
picture-uri-dark='file:///usr/share/backgrounds/ubuntu-wallpaper-d.png'
primary-color='#2c001e'
secondary-color='#2c001e'

[input-sources]
sources=[('xkb', 'us')]
xkb-options=@as []

[interface]
color-scheme='prefer-dark'
cursor-theme='Adwaita'
enable-animations=true
gtk-theme='Yaru-dark'
icon-theme='Yaru'
show-battery-percentage=true

[notifications]
application-children=['org-gnome-characters', 'firefox-firefox', 'spotify-spotify', 'org-gnome-settings', 'org-gnome-nautilus', 'gnome-power-panel', 'io-snapcraft-sessionagent', 'dev-zed-zed', 'brave-hnpfjngllnobngcgfapefoaidbinmjnm-default', 'brave-browser', 'discord-discord', 'snapd-desktop-integration-snapd-desktop-integration', 'org-gnome-terminal', 'org-gnome-eog', 'org-gnome-evince', 'libreoffice-calc', 'libreoffice-impress', 'org-gnome-texteditor', 'org-gnome-baobab', 'libreoffice-writer', 'update-manager', 'org-qbittorrent-qbittorrent', 'jupyterlab-desktop-jupyterlab-desktop', 'libreoffice-startcenter', 'code', 'antigravity', 'brave-cinhimbnkkaeohfgghhklpknlkffjgod-default', 'google-chrome', 'qoder', 'cursor', 'com-mattjakeman-extensionmanager', 'org-gnome-diskutility', 'supertuxkart', 'org-kde-falkon', 'dbeaver-ce', 'docker-desktop', 'org-mozilla-firefox', 'com-obsproject-studio', 'org-gnome-extensions', 'code-insiders', 'antigravity-ide', 'net-agalwood-motrix', 'ai-elementlabs-bionic']
show-banners=false

[notifications/application/ai-elementlabs-bionic]
application-id='ai.elementlabs.bionic.desktop'

[notifications/application/antigravity-ide]
application-id='antigravity-ide.desktop'

[notifications/application/antigravity]
application-id='antigravity.desktop'

[notifications/application/brave-browser]
